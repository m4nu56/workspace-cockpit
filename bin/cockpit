#!/usr/bin/env bash
# workspace-cockpit launcher.
#   bin/cockpit start [--config path/to/cockpit.toml]   start the web UI on 127.0.0.1 and open it
#   bin/cockpit install | uninstall | open               macOS: start at login + a "Workspace Cockpit" app
#   bin/cockpit <command> ...                            any CLI command (list, show, header, index, sessions, ...)
set -euo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
PYTHON="${PYTHON:-python3}"
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"

"$PYTHON" -c 'import sys; sys.exit(sys.version_info < (3, 11))' \
  || { echo "workspace-cockpit needs Python 3.11+ (set PYTHON=/path/to/python3)." >&2; exit 1; }

if [ "${1:-}" != "start" ]; then
  exec "$PYTHON" -m cockpit "$@"
fi
shift

# The web server runs from web/: pin the config to an absolute path before leaving the current directory.
case "${1:-}" in
  --config) COCKPIT_CONFIG="${2:-}" ;;
  --config=*) COCKPIT_CONFIG="${1#--config=}" ;;
esac
if [ -z "${COCKPIT_CONFIG:-}" ] && [ -f cockpit.toml ]; then
  COCKPIT_CONFIG="cockpit.toml"
fi
if [ -z "${COCKPIT_CONFIG:-}" ]; then
  echo "No cockpit.toml here. Run from your workspace, pass --config, or set COCKPIT_CONFIG." >&2
  echo "Start from $HERE/cockpit.example.toml" >&2
  exit 1
fi
if [ ! -f "$COCKPIT_CONFIG" ]; then
  echo "Config file not found: $COCKPIT_CONFIG" >&2
  exit 1
fi
COCKPIT_CONFIG="$(cd "$(dirname "$COCKPIT_CONFIG")" && pwd -P)/$(basename "$COCKPIT_CONFIG")"
export COCKPIT_CONFIG PYTHON COCKPIT_HOME="$HERE"

CONFIG_JSON="$("$PYTHON" -m cockpit config)" || { echo "$CONFIG_JSON" >&2; exit 1; }
PORT="$("$PYTHON" -c 'import json,sys; print(json.load(sys.stdin)["port"])' <<<"$CONFIG_JSON")"
URL="http://127.0.0.1:$PORT"
if [ -n "${COCKPIT_DRY_RUN:-}" ]; then echo "config=$COCKPIT_CONFIG"; exit 0; fi
# Already running (e.g. started by the LaunchAgent): exit 0 so launchd does not restart this one in a loop.
if "$PYTHON" -c 'import socket,sys; socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=1)' "$PORT" 2>/dev/null; then
  echo "workspace-cockpit is already running on $URL"
  exit 0
fi

command -v node >/dev/null || { echo "workspace-cockpit needs Node.js 20.9+." >&2; exit 1; }
cd "$HERE/web"
if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then npm ci; fi
if [ ! -f .next/BUILD_ID ] || [ -n "$(find app components lib proxy.ts package.json package-lock.json next.config.ts -newer .next/BUILD_ID -print -quit)" ]; then
  npm run build
fi
# macOS only: on Linux, `open` is often openvt.
if [ "$(uname)" = "Darwin" ] && [ -z "${COCKPIT_NO_BROWSER:-}" ]; then (sleep 3 && open "$URL") & fi
echo "workspace-cockpit on $URL (config: $COCKPIT_CONFIG)"
exec npx next start -H 127.0.0.1 -p "$PORT"
